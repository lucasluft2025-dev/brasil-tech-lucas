rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default-Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Startup connectivity check document
    match /test/connection {
      allow read: if true;
    }

    // --- Reusable Hardened Helpers ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Zero-lookup bootstrapped admin check (safe inside allow list)
    function isBootstrappedAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'lucasluft2025@gmail.com'
        || request.auth.token.email == 'luft446@gmail.com'
        || request.auth.token.email == 'brasilgames@gmail.com'
      );
    }

    // Full admin check for single-doc reads and writes
    function isAdmin() {
      return isBootstrappedAdmin() || (
        isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Validation Blueprints ---
    function isValidProduct(data) {
      return data.keys().hasAll([
          'id', 'name', 'cat', 'emoji', 'price', 'old', 'rating', 'reviews',
          'featured', 'desc', 'image', 'images', 'stock', 'sold',
          'warranty', 'condition', 'specs', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'name', 'cat', 'emoji', 'price', 'old', 'rating', 'reviews',
          'featured', 'desc', 'image', 'images', 'stock', 'sold',
          'warranty', 'condition', 'specs', 'createdAt', 'updatedAt'
        ])
        && data.id is number && data.id >= 1 && data.id <= 999999999999
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 200
        && data.cat is string && data.cat.size() >= 1 && data.cat.size() <= 60
        && data.emoji is string && data.emoji.size() >= 1 && data.emoji.size() <= 16
        && data.price is number && data.price > 0 && data.price <= 1000000
        && data.old is number && data.old >= 0 && data.old <= 1000000
        && data.rating is string && data.rating.size() >= 1 && data.rating.size() <= 16
        && data.reviews is number && data.reviews >= 0 && data.reviews <= 10000000
        && data.featured is bool
        && data.desc is string && data.desc.size() <= 2000
        && data.image is string && data.image.size() <= 500
        && data.images is list && data.images.size() >= 1 && data.images.size() <= 10 && data.images[0] is string
        && data.stock is number && data.stock >= 0 && data.stock <= 1000000
        && data.sold is number && data.sold >= 0 && data.sold <= 10000000
        && data.warranty is string && data.warranty.size() <= 120
        && data.condition is string && data.condition.size() <= 120
        && data.specs is list && data.specs.size() <= 15 && (data.specs.size() == 0 || data.specs[0] is map)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidProductCost(data) {
      return data.keys().hasAll(['productId', 'costPrice', 'updatedAt'])
        && data.keys().hasOnly(['productId', 'costPrice', 'updatedAt'])
        && data.productId is number && data.productId >= 1
        && data.costPrice is number && data.costPrice >= 0 && data.costPrice <= 1000000
        && data.updatedAt is timestamp;
    }

    function isValidUser(data, userId) {
      return data.keys().hasAll(['uid', 'name', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'name', 'email', 'photoUrl', 'cep', 'phone', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == userId && data.uid.size() <= 128
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500))
        && (!('cep' in data) || (data.cep is string && data.cep.size() <= 20))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 30))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdmin(data, adminId) {
      return data.keys().hasAll(['uid', 'email', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'createdAt'])
        && data.uid is string && data.uid == adminId && data.uid.size() <= 128
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.createdAt is timestamp;
    }

    function isValidOrder(data) {
      return data.keys().hasAll([
          'code', 'userId', 'customerEmail', 'customerName', 'customerCpf', 'customerPhone',
          'cep', 'address', 'cityState', 'shippingMethod', 'shippingLabel', 'shippingCost',
          'paymentMethod', 'paymentStatus', 'couponCode', 'subtotal', 'discount', 'total',
          'statusStep', 'trackingCode', 'items', 'createdAtLabel', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'code', 'userId', 'customerEmail', 'customerName', 'customerCpf', 'customerPhone',
          'cep', 'address', 'cityState', 'shippingMethod', 'shippingLabel', 'shippingCost',
          'paymentMethod', 'paymentStatus', 'couponCode', 'subtotal', 'discount', 'total',
          'statusStep', 'trackingCode', 'items', 'createdAtLabel', 'createdAt', 'updatedAt'
        ])
        && data.code is string && data.code.size() >= 3 && data.code.size() <= 40
        && data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128
        && data.customerEmail is string && data.customerEmail.size() >= 3 && data.customerEmail.size() <= 160
        && data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 120
        && data.customerCpf is string && data.customerCpf.size() <= 30
        && data.customerPhone is string && data.customerPhone.size() >= 5 && data.customerPhone.size() <= 30
        && data.cep is string && data.cep.size() >= 8 && data.cep.size() <= 20
        && data.address is string && data.address.size() >= 3 && data.address.size() <= 300
        && data.cityState is string && data.cityState.size() >= 2 && data.cityState.size() <= 120
        && data.shippingMethod in ['express', 'standard']
        && data.shippingLabel is string && data.shippingLabel.size() <= 120
        && data.shippingCost is number && data.shippingCost >= 0 && data.shippingCost <= 5000
        && data.paymentMethod in ['pix', 'card', 'boleto']
        && data.paymentStatus in ['pending', 'paid', 'refunded']
        && data.couponCode is string && data.couponCode.size() <= 40
        && data.subtotal is number && data.subtotal >= 0 && data.subtotal <= 5000000
        && data.discount is number && data.discount >= 0 && data.discount <= 5000000
        && data.total is number && data.total >= 0 && data.total <= 5000000
        && data.statusStep is number && data.statusStep >= 0 && data.statusStep <= 4
        && data.trackingCode is string && data.trackingCode.size() <= 60
        && data.items is list && data.items.size() >= 1 && data.items.size() <= 50 && data.items[0] is map
        && data.createdAtLabel is string && data.createdAtLabel.size() <= 60
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCoupon(data) {
      return data.keys().hasAll(['code', 'type', 'value', 'label', 'active', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['code', 'type', 'value', 'label', 'active', 'createdAt', 'updatedAt'])
        && data.code is string && data.code.size() >= 2 && data.code.size() <= 32
        && data.type in ['percent', 'fixed']
        && data.value is number && data.value > 0 && data.value <= 100000
        && data.label is string && data.label.size() >= 2 && data.label.size() <= 80
        && data.active is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidReview(data) {
      return data.keys().hasAll([
          'id', 'productId', 'product', 'author', 'city', 'rating', 'date', 'comment', 'userId', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'productId', 'product', 'author', 'city', 'rating', 'date', 'comment', 'userId', 'status', 'createdAt', 'updatedAt'
        ])
        && data.id is number && data.id >= 1
        && data.productId is number && data.productId >= 1
        && data.product is string && data.product.size() >= 1 && data.product.size() <= 160
        && data.author is string && data.author.size() >= 1 && data.author.size() <= 80
        && data.city is string && data.city.size() >= 1 && data.city.size() <= 80
        && data.rating is number && data.rating >= 1 && data.rating <= 5
        && data.date is string && data.date.size() >= 1 && data.date.size() <= 40
        && data.comment is string && data.comment.size() >= 2 && data.comment.size() <= 1000
        && data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128
        && data.status in ['pending', 'approved', 'rejected']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidQuestion(data) {
      return data.keys().hasAll([
          'productId', 'productName', 'userId', 'authorName', 'question', 'answer', 'date', 'answered', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'productId', 'productName', 'userId', 'authorName', 'question', 'answer', 'date', 'answered', 'createdAt', 'updatedAt'
        ])
        && data.productId is number && data.productId >= 1
        && data.productName is string && data.productName.size() >= 1 && data.productName.size() <= 160
        && data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80
        && data.question is string && data.question.size() >= 3 && data.question.size() <= 600
        && data.answer is string && data.answer.size() <= 1200
        && data.date is string && data.date.size() >= 1 && data.date.size() <= 60
        && data.answered is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSubscriber(data) {
      return data.keys().hasAll(['userId', 'email', 'createdAt'])
        && data.keys().hasOnly(['userId', 'email', 'createdAt'])
        && data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128
        && data.email is string && data.email.size() >= 5 && data.email.size() <= 160
        && data.createdAt is timestamp;
    }

    function isValidStoreSettings(data) {
      return data.keys().hasAll([
          'storeName', 'cnpj', 'address', 'phone', 'whatsappDigits', 'email',
          'expressShippingPrice', 'standardShippingPrice', 'pixDiscountPercent', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'storeName', 'cnpj', 'address', 'phone', 'whatsappDigits', 'email',
          'expressShippingPrice', 'standardShippingPrice', 'pixDiscountPercent', 'updatedAt'
        ])
        && data.storeName is string && data.storeName.size() >= 1 && data.storeName.size() <= 100
        && data.cnpj is string && data.cnpj.size() >= 5 && data.cnpj.size() <= 40
        && data.address is string && data.address.size() >= 3 && data.address.size() <= 200
        && data.phone is string && data.phone.size() >= 5 && data.phone.size() <= 30
        && data.whatsappDigits is string && data.whatsappDigits.size() >= 8 && data.whatsappDigits.size() <= 20
        && data.email is string && data.email.size() >= 5 && data.email.size() <= 160
        && data.expressShippingPrice is number && data.expressShippingPrice >= 0 && data.expressShippingPrice <= 5000
        && data.standardShippingPrice is number && data.standardShippingPrice >= 0 && data.standardShippingPrice <= 5000
        && data.pixDiscountPercent is number && data.pixDiscountPercent >= 0 && data.pixDiscountPercent <= 50
        && data.updatedAt is timestamp;
    }

    function isValidTracking(data) {
      return data.keys().hasAll([
          'code', 'orderCode', 'customerLabel', 'productSummary', 'cityState',
          'shippingLabel', 'statusStep', 'statusNote', 'active',
          'createdAtLabel', 'updatedAtLabel', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'code', 'orderCode', 'customerLabel', 'maskedCpf', 'productSummary', 'cityState',
          'originCityState', 'destinationCityState', 'currentLocation', 'routeProgress',
          'invoiceNumber', 'orderTotal', 'weightKg',
          'shippingLabel', 'statusStep', 'statusNote', 'active',
          'createdAtLabel', 'updatedAtLabel', 'createdAt', 'updatedAt'
        ])
        && data.code is string && data.code.size() >= 3 && data.code.size() <= 60 && data.code.matches('^[A-Z0-9_\\-]+$')
        && data.orderCode is string && data.orderCode.size() <= 40
        && data.customerLabel is string && data.customerLabel.size() >= 1 && data.customerLabel.size() <= 80
        && (!('maskedCpf' in data) || (data.maskedCpf is string && data.maskedCpf.size() <= 30))
        && data.productSummary is string && data.productSummary.size() >= 1 && data.productSummary.size() <= 240
        && data.cityState is string && data.cityState.size() >= 2 && data.cityState.size() <= 120
        && (!('originCityState' in data) || (data.originCityState is string && data.originCityState.size() <= 120))
        && (!('destinationCityState' in data) || (data.destinationCityState is string && data.destinationCityState.size() <= 120))
        && (!('currentLocation' in data) || (data.currentLocation is string && data.currentLocation.size() <= 160))
        && (!('routeProgress' in data) || (data.routeProgress is number && data.routeProgress >= 0 && data.routeProgress <= 100))
        && (!('invoiceNumber' in data) || (data.invoiceNumber is string && data.invoiceNumber.size() <= 40))
        && (!('orderTotal' in data) || (data.orderTotal is number && data.orderTotal >= 0 && data.orderTotal <= 5000000))
        && (!('weightKg' in data) || (data.weightKg is number && data.weightKg >= 0 && data.weightKg <= 500))
        && data.shippingLabel is string && data.shippingLabel.size() >= 2 && data.shippingLabel.size() <= 120
        && data.statusStep is number && data.statusStep >= 0 && data.statusStep <= 4
        && data.statusNote is string && data.statusNote.size() <= 300
        && data.active is bool
        && data.createdAtLabel is string && data.createdAtLabel.size() <= 60
        && data.updatedAtLabel is string && data.updatedAtLabel.size() <= 60
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTrackingPrivate(data, trackingId) {
      return data.keys().hasAll([
          'code', 'customerCpf', 'customerPhone', 'customerAddress', 'customerCep', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'code', 'customerCpf', 'customerPhone', 'customerAddress', 'customerCep', 'updatedAt'
        ])
        && data.code is string && data.code == trackingId && data.code.size() >= 3 && data.code.size() <= 60
        && data.customerCpf is string && data.customerCpf.size() <= 30
        && data.customerPhone is string && data.customerPhone.size() <= 30
        && data.customerAddress is string && data.customerAddress.size() <= 300
        && data.customerCep is string && data.customerCep.size() <= 20
        && data.updatedAt is timestamp;
    }

    // --- Collection Match Blocks ---

    // 1. Public Catalog Products
    match /products/{productId} {
      allow get: if isValidId(productId);
      allow list: if resource.data.price > 0;
      allow create: if isAdmin()
        && isValidId(productId)
        && isValidProduct(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(productId)
        && isValidProduct(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'cat', 'emoji', 'price', 'old', 'rating', 'reviews',
          'featured', 'desc', 'image', 'images', 'stock', 'sold',
          'warranty', 'condition', 'specs', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(productId);
    }

    // 2. Admin-only Product Cost Records
    match /productCosts/{productId} {
      allow get: if isAdmin() && isValidId(productId);
      allow list: if isBootstrappedAdmin();
      allow create, update: if isAdmin()
        && isValidId(productId)
        && isValidProductCost(incoming())
        && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(productId);
    }

    // 3. Customer Profiles (PII Isolated)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isBootstrappedAdmin();
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUser(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(userId)
        && (isOwner(userId) || isAdmin())
        && isValidUser(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'photoUrl', 'cep', 'phone', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(userId);
    }

    // 4. Admin Registry
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isOwner(adminId) || isBootstrappedAdmin());
      allow list: if isBootstrappedAdmin();
      allow create: if isBootstrappedAdmin()
        && isValidId(adminId)
        && isValidAdmin(incoming(), adminId)
        && incoming().createdAt == request.time;
      allow delete: if isBootstrappedAdmin() && isValidId(adminId);
    }

    // 5. Customer Orders (PII Isolated, Immutable Ownership)
    match /orders/{orderId} {
      allow get: if isValidId(orderId) && (
        (isSignedIn() && existing().userId == request.auth.uid) || isAdmin()
      );
      allow list: if (isSignedIn() && resource.data.userId == request.auth.uid) || isBootstrappedAdmin();
      allow create: if isVerifiedUser()
        && isValidId(orderId)
        && isValidOrder(incoming())
        && incoming().userId == request.auth.uid
        && incoming().statusStep <= 1
        && incoming().paymentStatus == 'pending'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(orderId)
        && isValidOrder(incoming())
        && incoming().userId == existing().userId
        && incoming().code == existing().code
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'statusStep', 'trackingCode', 'paymentStatus', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(orderId);
    }

    // 6. Promotional Coupons
    match /coupons/{couponId} {
      allow get: if isValidId(couponId) && (resource == null || resource.data.active == true || isAdmin());
      allow list: if resource.data.active == true || isBootstrappedAdmin();
      allow create: if isAdmin()
        && isValidId(couponId)
        && isValidCoupon(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(couponId)
        && isValidCoupon(incoming())
        && incoming().code == existing().code
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'type', 'value', 'label', 'active', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(couponId);
    }

    // 7. Verified Product Reviews with Pre-Publication Moderation (Zero PII)
    match /reviews/{reviewId} {
      allow get: if isValidId(reviewId) && (
        resource == null
        || existing().status == 'approved'
        || isAdmin()
        || (isSignedIn() && existing().userId == request.auth.uid)
      );
      allow list: if resource.data.status == 'approved'
        || isBootstrappedAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isVerifiedUser()
        && isValidId(reviewId)
        && isValidReview(incoming())
        && incoming().userId == request.auth.uid
        && incoming().status == 'pending'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(reviewId)
        && isValidReview(incoming())
        && incoming().id == existing().id
        && incoming().productId == existing().productId
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if (isVerifiedUser() && isValidId(reviewId) && existing().userId == request.auth.uid)
        || (isAdmin() && isValidId(reviewId));
    }

    // 8. Product Q&A (Zero PII)
    match /questions/{questionId} {
      allow get: if isValidId(questionId);
      allow list: if resource.data.productId >= 1;
      allow create: if isVerifiedUser()
        && isValidId(questionId)
        && isValidQuestion(incoming())
        && incoming().userId == request.auth.uid
        && incoming().answered == false
        && incoming().answer == ''
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(questionId)
        && isValidQuestion(incoming())
        && incoming().userId == existing().userId
        && incoming().productId == existing().productId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'answer', 'answered', 'date', 'updatedAt'
        ]);
      allow delete: if (isVerifiedUser() && isValidId(questionId) && existing().userId == request.auth.uid)
        || (isAdmin() && isValidId(questionId));
    }

    // 9. Newsletter Subscribers (PII Restricted)
    match /newsletter/{subscriberId} {
      allow get: if isValidId(subscriberId) && (
        (isSignedIn() && existing().userId == request.auth.uid) || isAdmin()
      );
      allow list: if isBootstrappedAdmin();
      allow create: if isVerifiedUser()
        && isValidId(subscriberId)
        && isValidSubscriber(incoming())
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time;
      allow delete: if isAdmin() && isValidId(subscriberId);
    }

    // 10. Public Store Settings (Admin-writable)
    match /storeSettings/{settingId} {
      allow get: if isValidId(settingId) && settingId == 'public';
      allow list: if isBootstrappedAdmin();
      allow create, update: if isAdmin()
        && isValidId(settingId)
        && settingId == 'public'
        && isValidStoreSettings(incoming())
        && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    // 11. Exact-Match Public Shipment Trackings (Zero unmasked PII, Admin-managed)
    match /trackings/{trackingId} {
      allow get: if isValidId(trackingId) && (
        resource == null || existing().active == true || isAdmin()
      );
      allow list: if isBootstrappedAdmin();
      allow create: if isAdmin()
        && isValidId(trackingId)
        && isValidTracking(incoming())
        && incoming().code == trackingId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(trackingId)
        && isValidTracking(incoming())
        && incoming().code == existing().code
        && incoming().createdAt == existing().createdAt
        && incoming().createdAtLabel == existing().createdAtLabel
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'orderCode', 'customerLabel', 'maskedCpf', 'productSummary', 'cityState',
          'originCityState', 'destinationCityState', 'currentLocation', 'routeProgress',
          'invoiceNumber', 'orderTotal', 'weightKg',
          'shippingLabel', 'statusStep', 'statusNote', 'active',
          'updatedAtLabel', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(trackingId);

      // Private PII subcollection for NF-e, shipping label & WhatsApp dispatch (Admin only)
      match /private/{detailId} {
        allow get: if isAdmin() && isValidId(trackingId) && isValidId(detailId);
        allow list: if isBootstrappedAdmin() && isValidId(trackingId);
        allow create, update: if isAdmin()
          && isValidId(trackingId)
          && isValidId(detailId)
          && detailId == 'details'
          && isValidTrackingPrivate(incoming(), trackingId)
          && incoming().updatedAt == request.time
          && existsAfter(/databases/$(database)/documents/trackings/$(trackingId));
        allow delete: if isAdmin() && isValidId(trackingId) && isValidId(detailId);
      }
    }
  }
}
